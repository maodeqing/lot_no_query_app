QWidget {
    background-color: #F5F7FA;
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    font-size: 14px;
    color: #333333;
}
QLabel#titleLabel {
    font-size: 20px; font-weight: bold; color: #1F2D3D; padding: 6px 0;
}
QLabel#hintLabel { color: #606266; font-size: 13px; }
QLabel#errorLabel { color: #F56C6C; font-size: 12px; }
QLineEdit {
    background-color: #FFFFFF; border: 1px solid #DCDFE6; border-radius: 6px;
    padding: 8px 12px; font-size: 15px; selection-background-color: #409EFF;
}
QLineEdit:focus { border: 1px solid #409EFF; }
QLineEdit#invalidInput { border: 1px solid #F56C6C; }
QTextEdit {
    background-color: #FFFFFF; border: 1px solid #DCDFE6; border-radius: 6px;
    padding: 10px; font-family: "Consolas", "Microsoft YaHei", monospace;
    font-size: 18px; color: #303133; selection-background-color: #409EFF;
}
QPushButton {
    background-color: #409EFF; color: #FFFFFF; border: none;
    border-radius: 6px; padding: 8px 16px; font-size: 14px;
}
QPushButton:hover { background-color: #66B1FF; }
QPushButton:pressed { background-color: #3A8EE6; }
QPushButton:disabled { background-color: #C0C4CC; color: #FFFFFF; }
QPushButton#secondaryBtn {
    background-color: #FFFFFF; color: #409EFF; border: 1px solid #409EFF;
}
QPushButton#secondaryBtn:hover { background-color: #ECF5FF; }